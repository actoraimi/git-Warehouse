# 统一换行符策略：仓库内与工作区均使用 LF，
# 避免 Windows 下 git 反复提示 "LF will be replaced by CRLF"。
* text=auto eol=lf

# 二进制文件禁止任何换行符转换，防止文件损坏
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.7z   binary
*.rar  binary
*.exe  binary
*.dll  binary
*.so   binary
*.dylib binary
*.mp3  binary
*.mp4  binary
*.mov  binary
*.woff binary
*.woff2 binary
*.ttf  binary
